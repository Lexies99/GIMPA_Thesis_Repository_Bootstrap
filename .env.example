APP_NAME=Gimpa Research Repository API
ENV=development
API_PREFIX=/api
SECRET_KEY=some_long_random_string
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/murrs
ALLOWED_EMAIL_DOMAINS=gimpa.edu.gh

# SMTP (optional; in-app notifications still work without this)
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Gimpa Research Repository
SMTP_TIMEOUT_SECONDS=30
SMTP_MAX_RETRIES=3
SMTP_RETRY_BACKOFF_SECONDS=1.5

# OnlyOffice integration (Option 1)
# Example doc server URL: http://127.0.0.1:8080
ONLYOFFICE_DOC_SERVER_URL=
# Must be reachable by the OnlyOffice server container/service
# Example: http://host.docker.internal:8001
PUBLIC_API_BASE_URL=http://127.0.0.1:8001
